# Copy to /srv/secondbrain/config/.env and fill in. Never commit the real file.

# General
APP_TIMEZONE=Europe/Berlin
DATA_ROOT=/srv/secondbrain

# PostgreSQL
POSTGRES_DB=secondbrain
POSTGRES_USER=secondbrain
POSTGRES_PASSWORD=change-me

# Local AI
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=change-after-benchmark

# File encryption
GPG_HOME=/srv/secondbrain/secrets/gnupg
GPG_KEY_FINGERPRINT=
GPG_PASSPHRASE_FILE=/srv/secondbrain/secrets/gpg_passphrase
STORAGE_HMAC_KEY_FILE=/srv/secondbrain/secrets/storage_hmac.key

# SimpleX bot
SIMPLEX_DATA_DIR=/srv/secondbrain/simplex
SIMPLEX_ALLOWED_CONTACT=   # filled in after you connect your phone to the bot

# Google (OAuth client for a Desktop app; consent screen set to "In production")
GOOGLE_CLIENT_SECRET_FILE=/srv/secondbrain/secrets/google_client_secret.json
GOOGLE_TOKEN_FILE=/srv/secondbrain/secrets/google_token.json
GOOGLE_CALENDAR_ID=primary

# External AI (later milestone; leave empty for v0.1)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
